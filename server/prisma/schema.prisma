generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String          @id @default(cuid())
  wallet             String          @unique
  username           String?
  bio                String?
  avatarUrl          String?
  skills             String?         // comma-separated tags
  githubHandle       String?
  completedAsWorker  Int             @default(0)
  completedAsClient  Int             @default(0)
  totalEarnedEth     Float           @default(0)
  totalEarnedUsd     Float           @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  comments           BountyComment[]
}

model BountyMetadata {
  id                       String          @id @default(cuid())
  bountyId                 Int             @unique
  title                    String
  description              String?
  category                 String          @default("General")
  skills                   String?         // Comma-separated skill tags, e.g. "Solidity,React,Ethers.js"
  tokenSymbol              String          @default("ETH") // e.g. "ETH" or "USDC"
  tokenAddress             String?         // address of ERC20 token or null for ETH
  disputeReason            String?
  isPrivateDeliverable     Boolean         @default(false)
  encryptedDeliverableData String?
  encryptedKeyEnvelope     String?
  createdAt                DateTime        @default(now())
  proposals                Proposal[]
  comments                 BountyComment[]
}

model Proposal {
  id                String         @id @default(cuid())
  bountyId          Int
  freelancerAddress String
  coverLetter       String
  timelineDays      Int            @default(7)
  portfolioUrl      String?
  status            String         @default("PENDING") // PENDING, ACCEPTED, REJECTED
  signature         String?        // EIP-712 signature hex
  isVerified        Boolean        @default(false)     // true if EIP-712 signature matches freelancerAddress
  createdAt         DateTime       @default(now())
  bounty            BountyMetadata @relation(fields: [bountyId], references: [bountyId], onDelete: Cascade)

  @@unique([bountyId, freelancerAddress])
}

model BountyComment {
  id        String         @id @default(cuid())
  bountyId  Int
  author    String         // wallet address
  content   String
  type      String         @default("MESSAGE") // "MESSAGE", "REVISION_REQUEST", "APPROVAL_NOTE"
  createdAt DateTime       @default(now())
  bounty    BountyMetadata @relation(fields: [bountyId], references: [bountyId], onDelete: Cascade)
  user      User?          @relation(fields: [author], references: [wallet])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  bountyId  Int
  eventType String   // "CREATED", "PROPOSAL_SUBMITTED", "ASSIGNED", "WORK_SUBMITTED", "MILESTONE_APPROVED", "COMPLETED", "DISPUTED"
  actor     String   // wallet address
  details   String?  // JSON or summary text
  txHash    String?
  createdAt DateTime @default(now())

  @@index([bountyId])
  @@index([eventType])
}