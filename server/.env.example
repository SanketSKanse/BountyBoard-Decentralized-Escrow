# PostgreSQL database connection URL (e.g. Neon, Render Postgres, Supabase)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# Port the backend server listens on (Render automatically provides this)
PORT=5000

# Production frontend URL for CORS (e.g. https://your-project.vercel.app)
FRONTEND_URL=http://localhost:5173
