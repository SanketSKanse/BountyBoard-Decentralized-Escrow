# Backend API Base URL (e.g. https://bountyboard-api.onrender.com or http://localhost:5055)
VITE_API_URL=http://localhost:5055

# Smart contract address on target network (defaults to local Hardhat address)
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Chain ID for target network (e.g. 31337 for local Hardhat, 11155111 for Sepolia)
VITE_CHAIN_ID=31337
