# Backend API Base URL (e.g. https://bountyboard-api.onrender.com or http://localhost:5055)
VITE_API_URL=http://localhost:5055

# Smart contract address on target network (e.g. deployed address on Base Sepolia)
VITE_CONTRACT_ADDRESS=

# Chain ID for target network (e.g. 84532 for Base Sepolia, 11155420 for OP Sepolia)
VITE_CHAIN_ID=84532
