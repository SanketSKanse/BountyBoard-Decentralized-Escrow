#!/usr/bin/env sh

echo "🛡️  Running pre-commit quality gates..."

# 1. Secret & Key Leak Scanner
echo "🔍 Scanning staged changes for secret leaks and .env files..."

# Check for accidentally staged .env files (excluding .env.example)
staged_env=$(git diff --cached --name-only | grep -E '(\.env($|\..*)|(^|/)\.env)' | grep -v '\.env\.example$' || true)
if [ -n "$staged_env" ]; then
    echo "❌ COMMIT REJECTED: Leaked private key or .env file detected! Never commit secrets to GitHub."
    echo "Accidentally staged environment file(s):"
    echo "$staged_env"
    exit 1
fi

# Check for staged private keys (64-character hex patterns) in added lines
if git diff --cached | grep -E '^\+[^+]' | grep -E -iq '(^|[^a-f0-9])(0x)?[a-f0-9]{64}([^a-f0-9]|$)'; then
    echo "❌ COMMIT REJECTED: Leaked private key or .env file detected! Never commit secrets to GitHub."
    exit 1
fi

# 2. Typecheck Gate
echo "🔍 Running TypeScript verification across client, server, and contracts..."
if ! npm run typecheck; then
    echo "❌ COMMIT REJECTED: TypeScript compilation errors found! Fix typecheck errors before committing."
    exit 1
fi

echo "✅ Pre-commit verification passed successfully!"
