# ==============================================================================
# BountyBoard Environment Variables Reference
# Copy service-specific configurations into client/.env, server/.env, or contracts/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND (client/.env)
# ------------------------------------------------------------------------------
# Production backend API URL (e.g., https://your-backend.onrender.com)
VITE_API_URL=http://localhost:5055

# Smart contract address (optional - defaults to local Hardhat deployment address)
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Blockchain network chain ID (e.g., 31337 for Hardhat, 11155111 for Sepolia, 84532 for Base Sepolia)
VITE_CHAIN_ID=31337

# ------------------------------------------------------------------------------
# BACKEND (server/.env)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (Neon / Render / Supabase)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# Platform port (Render assigns this dynamically)
PORT=5000

# Allowed frontend origin for CORS (e.g., https://your-project.vercel.app)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# SMART CONTRACTS (contracts/.env)
# ------------------------------------------------------------------------------
# Deployer wallet private key (NEVER commit real keys)
DEPLOYER_PRIVATE_KEY=

# Local Hardhat node RPC
RPC_URL=http://127.0.0.1:8545

# Ethereum Sepolia RPC URL (e.g. Alchemy, Infura, or public endpoint)
SEPOLIA_RPC_URL=

# Base Sepolia RPC URL (default public RPC: https://sepolia.base.org)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ------------------------------------------------------------------------------
# FREE TESTNET ETH FAUCETS
# ------------------------------------------------------------------------------
# - Google Cloud Web3 Faucet (Ethereum Sepolia):
#   https://cloud.google.com/application/web3/faucet/ethereum/sepolia
# - Coinbase Developer Faucet (Base Sepolia):
#   https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
# - Alchemy Sepolia Faucet:
#   https://sepoliafaucet.com/
